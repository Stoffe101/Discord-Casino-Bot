# ─── Discord application (create at https://discord.com/developers/applications) ───
# Bot token (Bot tab → Reset Token). NEVER commit the real value.
DISCORD_TOKEN=
# Application ID (General Information tab).
DISCORD_CLIENT_ID=
# Optional: a guild (server) ID for instant slash-command registration while developing.
# Leave empty to register commands globally (can take up to an hour to appear).
DISCORD_DEV_GUILD_ID=

# ─── Runtime ───
# development | production
NODE_ENV=development
# Path to the SQLite database file (created automatically).
DATABASE_PATH=./data/casino.db
# trace | debug | info | warn | error
LOG_LEVEL=info
# Directory for rotating JSON log files. Leave empty to log to the console only.
LOG_DIR=./logs
# Set to "true" to allow the protected development data reset (/casinoadmin reset-dev).
# It only ever works in DISCORD_DEV_GUILD_ID and when NODE_ENV=development.
ALLOW_DEV_RESET=false

# Test mode (optional): restrict every outgoing Discord action to ONE channel and disable threads.
# Fill in with: npm run test:allowlist -- --write   (finds the #casino channel of DISCORD_DEV_GUILD_ID)
# CASINO_TEST_MODE=true
# CASINO_TEST_GUILD_ID=
# CASINO_TEST_CHANNEL_ID=
# Also allow table threads, but only threads whose parent is that channel (verified from Discord's data):
# CASINO_TEST_ALLOW_THREADS=true
